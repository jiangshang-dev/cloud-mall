<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 单体业务工程：底层依赖 company/lingxi JeecgBoot 3.9.2 -->
    <parent>
        <groupId>org.jeecgframework.boot3</groupId>
        <artifactId>jeecg-boot-parent</artifactId>
        <version>3.9.2</version>
        <relativePath>../../company/lingxi/JeecgBoot/jeecg-boot/pom.xml</relativePath>
    </parent>

    <groupId>com.mall</groupId>
    <artifactId>cloud-mall</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>cloud-mall</name>
    <description>Fondia 单体：业务在 mall-modules，Controller 在 mall-web</description>

    <modules>
        <module>mall-common</module>
        <module>mall-modules</module>
        <module>mall-web</module>
    </modules>

    <properties>
        <mall.version>1.0.0</mall.version>
        <jeecgboot.version>3.9.2</jeecgboot.version>
        <java.version>21</java.version>
        <agentscope.version>2.0.0-RC4</agentscope.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.mall</groupId>
                <artifactId>mall-common</artifactId>
                <version>${mall.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mall</groupId>
                <artifactId>mall-media</artifactId>
                <version>${mall.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mall</groupId>
                <artifactId>mall-user</artifactId>
                <version>${mall.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mall</groupId>
                <artifactId>mall-cuisine</artifactId>
                <version>${mall.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mall</groupId>
                <artifactId>mall-search</artifactId>
                <version>${mall.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mall</groupId>
                <artifactId>mall-ai</artifactId>
                <version>${mall.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mall</groupId>
                <artifactId>mall-interaction</artifactId>
                <version>${mall.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mall</groupId>
                <artifactId>mall-member</artifactId>
                <version>${mall.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mall</groupId>
                <artifactId>mall-support</artifactId>
                <version>${mall.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jeecgframework.boot3</groupId>
                <artifactId>jeecg-system-biz</artifactId>
                <version>${jeecgboot.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>aliyun</id>
            <name>aliyun Repository</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
            <id>jeecg</id>
            <name>jeecg Repository</name>
            <url>https://maven.jeecg.com/nexus/content/repositories/jeecg</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
</project>
